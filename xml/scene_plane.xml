<mujoco model="QD1 scenemesh">
  <include file="T1-V2.xml" />

  <statistic center="0 0 0.1" extent="0.8" />

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="-130" elevation="-20" />
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072" />
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2" />
  <hfield name="perlin_hfield" size="1.0 0.75 0.2 0.2" file="../height_field.png" />
  <hfield name="image_hfield" size="1.0 1.0 0.02 0.1" file="../unitree_hfield.png" />
    <!-- 新增：5度斜坡高度场 -->
    <hfield name="ramp_5_hfield" size="5 2 1 1" nrow="10" ncol="10"/>
    <!-- 新增：10度斜坡高度场 -->
    <hfield name="ramp_10_hfield" size="5 2 1 1" nrow="10" ncol="10"/>
    <!-- 新增：15度斜坡高度场 -->
    <hfield name="ramp_15_hfield" size="5 2 1 1" nrow="10" ncol="10"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" />
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" />
    <!-- 新增：5度斜坡 (约 0.174 弧度) -->
    <geom name="ramp_5" 
          type="hfield" 
          hfield="ramp_5_hfield" 
          pos="5 -5 0" 
          euler="0 -0.0873 0."/>
    <!-- 新增：10度斜坡 (约 0.174 弧度) -->
    <geom name="ramp_10" 
          type="hfield" 
          hfield="ramp_10_hfield" 
          pos="5 0 0" 
          euler="0 -0.174 0."/>
    <!-- 新增：15度斜坡 (约 0.262 弧度) -->
    <geom name="ramp_15" 
          type="hfield" 
          hfield="ramp_15_hfield" 
          pos="5 5 0" 
          euler="0 -0.262 0."/>
  </worldbody>
</mujoco>
